{
  "name": "backend",
  "version": "0.0.1",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot ./src/server.ts",
    "build": "bun build --compile --minify --sourcemap ./src/server.ts --outfile dist/unified-app-backend --target=bun-linux-x64 --define process.env.NODE_ENV='\"production\"'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf ./node_modules/ ./dist/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.677.0",
    "@hono/trpc-server": "^0.3.2",
    "@hono/zod-validator": "^0.1.0",
    "@sinclair/typebox": "^0.31.0",
    "@trpc/server": "catalog:",
    "generic-pool": "^3.9.0",
    "hono": "^4.6.5",
    "ioredis": "^5.4.1",
    "neverthrow": "^6.0.0",
    "rate-limiter-flexible": "^3.0.0",
    "superjson": "catalog:",
    "winston": "^3.15.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "exports": {
    ".": {
      "types": [
        "./src/server.ts",
        "./bun.d.ts"
      ],
      "default": "./src/server.ts"
    }
  }
}
